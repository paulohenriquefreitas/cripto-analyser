+"""Diagnostic record contract + real offline-auditor integration; no MT5 calls.
+
+Events below are synthetic fixtures, not output from executing the EX5.
+Source checks guard the unchanged comparator and isolation of diagnostic payloads.
+"""
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import re
+import unittest
+
+from mt5_cursor_content_diagnostic import raw, reconstruct, replay
+import test_mt5_mql5_event_audit as audit_tests
+from test_mt5_cursor_recovery_source import function
+
+EA = Path(__file__).parent/'mql5'/'WinZ26EventJointProbe.mq5'
+FIXTURE = Path(__file__).parent/'fixtures'/'mt5_cursor_content_8026703.json'
+
+
+class CursorDiagnosticIntegrationTest(unittest.TestCase):
+    run_rows = audit_tests.EventAuditTest.run_rows
+
+    def setUp(self):
+        fixture = json.loads(FIXTURE.read_text(encoding='utf-8'))
+        self.cursor, self.prefix, _, _ = reconstruct(fixture)
+
+    def diagnostic(self, response):
+        result = replay(self.cursor, self.prefix, response)
+        self.assertEqual(result['reason'], 'CURSOR_PREFIX_CONTENT_MISMATCH')
+        diff = result['first_difference']
+        return dict(kind='cursor_prefix_mismatch_diagnostic', diagnostic_schema=1,
+                    parent_sequence=4, diagnostic_only=True, rows_are_new=False, accepted_rows=0,
+                    cursor_before=dict(time_msc=self.cursor[0], ordinal=self.cursor[1]),
+                    returned_rows=len(response), query_start_us=111000, query_end_us=111006,
+                    query_duration_us=6, expected_prefix=deepcopy(self.prefix),
+                    returned_raw_rows=deepcopy(response), expected_prefix_total=2,
+                    first_response_index=diff['response_index'], first_prefix_index=diff['prefix_ordinal']-1,
+                    first_expected=diff['expected'], first_received=diff['received'],
+                    different_fields=diff['fields'], expected_prefix_written=2,
+                    returned_rows_written=len(response), truncated=False)
+
+    def capture(self, diagnostic=None):
+        rows = audit_tests.complete_rows()
+        rows[0]['cursor_seed_ms'] = self.cursor[0]
+        rows[2]['ticks'] = [dict(t, cursor_ordinal=i+1) for i, t in enumerate(self.prefix)]
+        rows[2]['cursor_before'] = dict(time_msc=self.cursor[0], ordinal=0)
+        rows[2]['cursor_after'] = dict(time_msc=self.cursor[0], ordinal=2)
+        failed = deepcopy(rows[2])
+        failed.update(sequence=4, ok=False, rows_are_new=False, ticks=[], returned_rows=5,
+                      cursor_before=deepcopy(rows[2]['cursor_after']),
+                      cursor_after=deepcopy(rows[2]['cursor_after']),
+                      handler_start_us=111000, handler_end_us=111020,
+                      query_start_us=111000, query_end_us=111006)
+        rows.insert(-1, failed)
+        if diagnostic is not None:
+            rows.insert(-1, diagnostic)
+        rows[-1].update(fault='CURSOR_PREFIX_CONTENT_MISMATCH', completed_window=False)
+        return rows
+
+    def assert_evidence_only(self, event):
+        baseline = self.run_rows(self.capture())
+        report = self.run_rows(self.capture(event))
+        for field in ('quality', 'segments', 'raw_ticks', 'trade_ticks', 'quote_ticks',
+                      'query_errors', 'cursor_continuity', 'handler_metrics', 'integrity_issues'):
+            self.assertEqual(report[field], baseline[field], field)
+        self.assertNotIn('unknown_record_kind', report['integrity_issues'])
+        self.assertEqual(report['cursor_prefix_mismatch_diagnostics'], [event])
+        self.assertEqual((report['raw_ticks'], report['trade_ticks'], report['quote_ticks']), (2, 0, 2))
+        self.assertEqual(report['quality']['classification'], 'INCOMPLETO')
+        return report
+
+    def test_reordering_records_exact_pair_and_does_not_promote_evidence(self):
+        response = list(reversed(deepcopy(self.prefix)))
+        event = self.diagnostic(response)
+        self.assertEqual(event['different_fields'], ['ask', 'flags'])
+        self.assertEqual(event['first_response_index'], 0)
+        self.assertEqual(event['expected_prefix'], self.prefix)
+        self.assertEqual(event['returned_raw_rows'], response)
+        self.assert_evidence_only(event)
+
+    def test_bid_and_ask_change_each_identified_without_acceptance(self):
+        for field in ('bid', 'ask'):
+            with self.subTest(field=field):
+                response = deepcopy(self.prefix)
+                response[0][field] += 5.
+                event = self.diagnostic(response)
+                self.assertEqual(event['different_fields'], [field])
+                self.assert_evidence_only(event)
+
+    def test_flags_difference_at_second_position(self):
+        response = deepcopy(self.prefix)
+        response[1]['flags'] ^= 1024
+        event = self.diagnostic(response)
+        self.assertEqual(event['different_fields'], ['flags'])
+        self.assertEqual((event['first_response_index'], event['first_prefix_index']), (1, 1))
+        self.assert_evidence_only(event)
+
+    def test_legitimate_duplicates_retained_in_both_arrays(self):
+        # A valid repeated occurrence remains new, so produces no mismatch.
+        stable = deepcopy(self.prefix)+[deepcopy(self.prefix[-1])]
+        self.assertTrue(replay(self.cursor, self.prefix, stable)['ok'])
+        self.assertEqual(len(replay(self.cursor, self.prefix, stable)['accepted']), 1)
+        # In a failed response, repetitions must survive diagnostic serialization too.
+        trade = dict(self.prefix[0], time_msc=self.cursor[0]+1, flags=1080)
+        event = self.diagnostic(list(reversed(deepcopy(self.prefix)))+[trade, deepcopy(trade)])
+        decoded = json.loads(json.dumps(event))
+        self.assertEqual(decoded['returned_raw_rows'][-2:], [trade, trade])
+        self.assert_evidence_only(decoded)
+
+    def test_truncated_or_spoofed_diagnostic_never_counts_as_ticks(self):
+        event = self.diagnostic(list(reversed(deepcopy(self.prefix))))
+        event.update(truncated=True, returned_rows_written=1,
+                     returned_raw_rows=event['returned_raw_rows'][:1],
+                     ticks=[dict(self.prefix[0], flags=1080, cursor_ordinal=3)],
+                     rows_are_new=True, ok=True)
+        self.assert_evidence_only(event)
+
+    def test_maximum_normal_batch_keeps_duplicate_order_in_auditor(self):
+        response = list(reversed(deepcopy(self.prefix)))+[deepcopy(self.prefix[1])]*2046
+        event = self.diagnostic(response)
+        report = self.assert_evidence_only(event)
+        self.assertEqual(len(report['cursor_prefix_mismatch_diagnostics'][0]['returned_raw_rows']), 2048)
+
+    def test_raw_precision_contract_keeps_small_values_and_ulong(self):
+        event = self.diagnostic(list(reversed(deepcopy(self.prefix))))
+        event['returned_raw_rows'][0].update(bid=1e-200, volume=18446744073709551615)
+        decoded = json.loads(json.dumps(event))
+        self.assertEqual(decoded['returned_raw_rows'][0]['bid'], 1e-200)
+        self.assertEqual(decoded['returned_raw_rows'][0]['volume'], 18446744073709551615)
+        self.assert_evidence_only(decoded)
+

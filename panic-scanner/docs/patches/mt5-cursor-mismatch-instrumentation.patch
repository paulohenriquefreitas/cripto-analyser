+class CursorDiagnosticSourceTest(unittest.TestCase):
+    def setUp(self):
+        self.source = EA.read_text(encoding='utf-8-sig')
+
+    def test_comparator_unchanged_from_deployed_1_01(self):
+        # Normalized text fingerprint from the pre-change EA.
+        expected = '7cbfc0a8530b149c6779b162c89cb64655fede1cc200f26475fc2443664605b9'
+        self.assertEqual(hashlib.sha256(function(self.source, 'SameTick').encode()).hexdigest(), expected)
+
+    def test_capture_has_no_fault_cursor_counters_or_queue_side_effects(self):
+        capture = function(self.source, 'CaptureCursorDiagnostic')
+        self.assertNotRegex(capture, r'\b(NewObservation|Enqueue|CopyTicks|WriteLine)\(')
+        self.assertNotRegex(capture, r'\b(fault|cursor_ms|cursor_ordinal|raw_ticks|trades|quotes)\s*(?:=|\+=|\+\+)')
+        self.assertIn('if(cursor_diagnostic_captured) return;', capture)
+        self.assertIn('CURSOR_DIAGNOSTIC_MAX_ROWS', capture)
+
+    def test_raw_serializer_has_no_classification_and_uses_roundtrip_precision(self):
+        serializer = function(self.source, 'DiagnosticTick')
+        self.assertNotIn('TickRow(', serializer)
+        self.assertNotIn('classification', serializer)
+        self.assertNotIn('cursor_ordinal', serializer)
+        self.assertIn('StringFormat("%.17g",x)', function(self.source, 'DiagnosticDouble'))
+        for field in ('time', 'time_msc', 'bid', 'ask', 'last', 'volume', 'volume_real', 'flags'):
